# --------------------------------------------------
# Zincy Development Environment
# Copy this file to .env.dev and replace placeholders.
# Never commit .env.dev.
# --------------------------------------------------

COMPOSE_PROJECT_NAME=zincy-dev

# Spring
SPRING_PROFILES_ACTIVE=dev
PORT=8081

# MySQL
MYSQL_DATABASE=zincy_corporation_dev
MYSQL_USER=zincy_dev
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# Backend database connection inside Docker network
DB_URL=jdbc:mysql://mysql:3306/zincy_corporation_dev?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=zincy_dev
DB_PASSWORD=change-me

# Frontend / CORS
FRONTEND_URL=https://dev.zincycorp.in
EXPO_PUBLIC_APP_ENV=dev
EXPO_PUBLIC_API_BASE_URL=/api

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# MSG91
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
