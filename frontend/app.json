{
  "expo": {
    "name": "Zincy Corporation",
    "slug": "zincy-corporation",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/zincycorp-icon.png",
    "scheme": "zincycorporation",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/zincycorp-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.subhash011.zincycorporation"
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/zincy-logo.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
