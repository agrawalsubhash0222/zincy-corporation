# Docker
COMPOSE_PROJECT_NAME=zincy

# Spring
SPRING_PROFILES_ACTIVE=prod
PORT=8081

# MySQL
MYSQL_DATABASE=zincy_corporation
MYSQL_USER=zincy_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Backend database connection
DB_URL=jdbc:mysql://mysql:3306/zincy_corporation?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=zincy_app
DB_PASSWORD=

# Frontend / CORS
FRONTEND_URL=https://zincycorp.in,https://www.zincycorp.in
EXPO_PUBLIC_APP_ENV=prod
EXPO_PUBLIC_API_BASE_URL=/api

# Twilio fallback
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# WhatsApp Cloud API
WHATSAPP_API_URL=https://graph.facebook.com/v25.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=zincy_login_otp
WHATSAPP_TEMPLATE_LANGUAGE=en

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# MSG91
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=